function criarFormulario() {
  const it = DriveApp.getFoldersByName(PASTA);
  if (!it.hasNext()) throw new Error('Pasta não encontrada no Drive: ' + PASTA);
  const pasta = it.next();
  const links = {};
  const arqs = pasta.getFiles();
  while (arqs.hasNext()) {
    const f = arqs.next();
    if (f.getMimeType() !== MimeType.PDF) continue;
    f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    links[f.getName().slice(0, 4)] = f.getUrl();
  }
  const form = FormApp.create('Classificação às cegas – interações graves nas bulas de estatinas');
  form.setDescription(INTRO).setProgressBar(true).setAllowResponseEdits(true).setLimitOneResponsePerUser(false);
  form.addTextItem().setTitle('Seu nome').setRequired(true);
  BULAS.forEach(function (b) {
    form.addPageBreakItem().setTitle(b.id + ' – ' + b.produto + ' (' + b.estatina + ')')
      .setHelpText('Empresa: ' + b.empresa + '\nABRA A BULA: ' + (links[b.id] || '(PDF não encontrado na pasta)') +
        '\n\n' + b.farmacos.length + ' interações graves para classificar. Leia a bula inteira, não só a seção de interações.');
    form.addGridItem().setTitle(b.id + ' · 1. Citação')
      .setHelpText('Nominal = nome do fármaco aparece. Por classe = classe/mecanismo que o inclui segundo o Anexo de pertinência (ex.: "inibidores potentes do CYP3A4" para itraconazol). Não citada = nem nome nem classe específica.')
      .setRows(b.farmacos).setColumns(['Nominal', 'Por classe', 'Não citada']).setRequired(true);
    form.addGridItem().setTitle(b.id + ' · 2. Manejo')
      .setHelpText('O que a bula manda fazer. Se marcou "Não citada", escolha "Não se aplica". Havendo mais de uma orientação, marque a mais restritiva.')
      .setRows(b.farmacos).setColumns(['Contraindicar/evitar', 'Limite de dose', 'Monitorar', 'Sem orientação', 'Não se aplica (não citada)']).setRequired(true);
    form.addParagraphTextItem().setTitle(b.id + ' · Observações (opcional)');
  });
  const ss = SpreadsheetApp.create('Respostas – classificação às cegas (avaliadora 2)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  DriveApp.getFileById(form.getId()).moveTo(pasta);
  DriveApp.getFileById(ss.getId()).moveTo(pasta);
  Logger.log('EDITAR: ' + form.getEditUrl());
  Logger.log('LINK PARA A AVALIADORA: ' + form.getPublishedUrl());
  Logger.log('PLANILHA DE RESPOSTAS: ' + ss.getUrl());
  Logger.log('PDFs com link: ' + Object.keys(links).length + ' de ' + BULAS.length);
}
